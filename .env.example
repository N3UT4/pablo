# =====================================================================
# ITZA TATTOO — Variables de entorno
# =====================================================================
# Copia este archivo como ".env" y ajusta los valores según tu entorno.
# El archivo ".env" está excluido del control de versiones por seguridad.
# =====================================================================

# --- Entorno de la aplicación ---
APP_ENV=development
APP_URL=

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=itza_tattoo
DB_USER=root
DB_PASSWORD=

# --- Código de acceso para staff ---
# Debe coincidir con STAFF_CODE en js/galeria.js y js/consentimiento.js
STAFF_ACCESS_CODE=ITZA-STAFF-2026

# --- Datos de contacto del estudio ---
# STUDIO_WHATSAPP: número en formato internacional SIN +, SIN espacios ni guiones
# Ejemplo Colombia: 573014003006  (código país 57 + 3014003006)
STUDIO_CITY=Bogotá, La Victoria - 20 de Julio
STUDIO_ADDRESS=Calle 42 A Sur # 3C - 65 Este
STUDIO_PHONE=301 400 3006
STUDIO_WHATSAPP=573014003006
STUDIO_INSTAGRAM=https://www.instagram.com/itza.tattoo
STUDIO_FACEBOOK=https://www.facebook.com/share/1CfAtuh5Bx/
STUDIO_TIKTOK=https://www.tiktok.com/@itza_tattoo
STUDIO_MAPS=https://maps.app.goo.gl/drjEamHAYwjngxh57

# --- Mensaje predeterminado para enlaces de WhatsApp ---
# Se usará como texto pre-llenado al abrir wa.me
STUDIO_WHATSAPP_MESSAGE=
