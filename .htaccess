Options -Indexes
DirectoryIndex index.php

# Redirecciones de las páginas .html antiguas a las rutas PHP del sistema MVC.
RewriteEngine On
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^index\.html$ %1index.php?action=home [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^login\.html$ %1index.php?action=login [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^registro\.html$ %1index.php?action=register [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^dashboard\.html$ %1index.php?action=dashboard [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^contacto\.html$ %1index.php?action=contact [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^galeria\.html$ %1index.php?action=gallery [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^abono\.html$ %1index.php?action=booking [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^consentimiento\.html$ %1index.php?action=consent [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^perfil\.html$ %1index.php?action=profile [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^promociones\.html$ %1index.php?action=promotions [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^404\.html$ %1index.php?action=404 [R=301,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)?)
RewriteRule ^500\.html$ %1index.php?action=500 [R=301,L]

# El router MVC renderiza sus vistas 404/500 cuando se invoca directamente;
# se omiten ErrorDocument absolutos para no romper montajes en subdirectorios.

<FilesMatch "^(database\.sql|README\.md|\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
